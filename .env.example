# ============================================================
# FRONTEND (Vite) — ces variables SONT exposées au navigateur.
# Ne JAMAIS y mettre de secret Saferpay / SOAP.
# ============================================================
# URL de base des Edge Functions Supabase
VITE_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1
# Clé anon publique du projet Supabase (non secrète)
VITE_SUPABASE_ANON_KEY=eyJ...

# ============================================================
# BACKEND (Edge Functions Supabase) — SECRETS.
# À configurer via `supabase secrets set ...`, PAS dans le repo.
# ============================================================
# Supabase (injectées automatiquement en prod, utiles en local)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Saferpay (⚠️ À RÉGÉNÉRER — les anciennes clés ont circulé en clair)
SAFERPAY_CUSTOMER_ID=81444
SAFERPAY_TERMINAL_ID=17894337
SAFERPAY_JSON_KEY=API_81444_xxxxxxxx
SAFERPAY_JSON_SECRET=xxxxxxxx
SAFERPAY_TEST=true
SAFERPAY_SPEC_VERSION=1.35

# SOAP — logiciel de gestion gsinfo.ch (MAW_WebService)
# Valeurs par défaut déjà codées ; ne surcharger qu'en cas de changement.
SOAP_ENDPOINT=http://myfitness.gsinfo.ch/MAW_WEBSERVICE_WEB/awws/MAW_WebService.awws
SOAP_NAMESPACE=urn:MAW_WebService
SOAP_LOGIN=-1
SOAP_PASSWORD=

# Emails (Resend)
RESEND_API_KEY=
ADMIN_EMAIL=info@green-fit.ch
FROM_EMAIL=info@green-fit.ch

# URLs publiques
SITE_URL=https://www.green-fit.ch
FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1
ALLOWED_ORIGINS=https://www.green-fit.ch,http://localhost:5173
