# ============================================================
# BACKEND — Fonctions serverless Vercel (dossier /api).
# À configurer dans Vercel → Settings → Environment Variables.
# Le frontend appelle /api en même origine : AUCUNE variable
# VITE_* n'est nécessaire pour le paiement.
# ============================================================

# Supabase (base de données)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Saferpay (⚠️ À RÉGÉNÉRER — les anciennes clés ont circulé en clair)
SAFERPAY_CUSTOMER_ID=81444
SAFERPAY_TERMINAL_ID=17894337
SAFERPAY_JSON_KEY=API_81444_xxxxxxxx
SAFERPAY_JSON_SECRET=xxxxxxxx
# false = production (par défaut), true = environnement de test Saferpay
SAFERPAY_TEST=false
SAFERPAY_SPEC_VERSION=1.35

# SOAP — logiciel de gestion gsinfo.ch (MAW_WebService)
# Valeurs par défaut déjà codées ; ne surcharger qu'en cas de changement.
SOAP_ENDPOINT=http://myfitness.gsinfo.ch/MAW_WEBSERVICE_WEB/awws/MAW_WebService.awws
SOAP_NAMESPACE=urn:MAW_WebService
SOAP_LOGIN=-1
SOAP_PASSWORD=

# Emails — SMTP (boîte info@green-fit.ch)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=info@green-fit.ch
SMTP_PASS=
SMTP_SECURE=false
ADMIN_EMAIL=info@green-fit.ch
FROM_EMAIL=info@green-fit.ch
SITE_URL=https://greenfit-nu.vercel.app

# Accès espace admin (/admin)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
